# Секреты FuturesArbBot. Скопируйте в .env (он в .gitignore — не коммитить).
#
# Ключи бирж: ARB_<ID>_API_KEY / ARB_<ID>_SECRET / ARB_<ID>_PASSWORD (ID — как в exchanges.yaml, любым регистром).
ARB_OKX_API_KEY=
ARB_OKX_SECRET=
ARB_OKX_PASSWORD=

ARB_GATE_API_KEY=
ARB_GATE_SECRET=

# Уведомления MAX Messenger:
# ARB_NOTIFICATIONS__BOT_TOKEN=
# ARB_NOTIFICATIONS__ADMIN_CHAT_ID=

# Любой ключ YAML-конфигурации можно переопределить: ARB_<РАЗДЕЛ>__<КЛЮЧ>[__<ВЛОЖЕННЫЙ>]
# ARB_GENERAL__NETWORK_MODE=DryRun
# ARB_ARBITRAGE__ENABLED=false
