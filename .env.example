# Скопируйте в .env и заполните. Файл .env не должен попадать в git.
# Ключи бирж: ARB_<ID>_API_KEY / ARB_<ID>_SECRET / ARB_<ID>_PASSWORD, где <ID> — id ccxt
# верхним регистром (BINANCEUSDM, BYBIT, OKX, GATE, MEXC, KUCOINFUTURES, BITGET, HTX, BINGX…).

ARB_OKX_API_KEY=
ARB_OKX_SECRET=
ARB_OKX_PASSWORD=

ARB_GATE_API_KEY=
ARB_GATE_SECRET=

# Необязательное: токен бота MAX Messenger и chat_id администратора
# (chat_id узнаётся командой: uv run arb-bot --notify-chat-id)
ARB_Notifications__BotToken=
ARB_Notifications__AdminChatId=
